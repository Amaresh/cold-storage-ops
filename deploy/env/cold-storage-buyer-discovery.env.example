# Core preview configuration used by run.py
BUYER_DISCOVERY_STARTER_TOWNS=Guntur
BUYER_DISCOVERY_WAREHOUSE_HUB_TOWN=Guntur
BUYER_DISCOVERY_MAX_RADIUS_KM=300
BUYER_DISCOVERY_QUERY_SEEDS="chilli wholesaler,chilli commission agent"
BUYER_DISCOVERY_SEARCH_FALLBACK_URL_TEMPLATES=https://www.startpage.com/do/dsearch?query={query},https://search.yahoo.com/search?p={query}
BUYER_DISCOVERY_SEARCH_FALLBACK_URL_TEMPLATE=https://search.brave.com/search?q={query}

# Reserved for backend ingestion wiring
BUYER_DISCOVERY_BACKEND_BASE_URL=http://127.0.0.1:9090
BUYER_DISCOVERY_TENANT_ID=demo-tenant
BUYER_DISCOVERY_WAREHOUSE_ID=guntur-hub
BUYER_DISCOVERY_INTERNAL_API_HEADER=X-API-Key
# BUYER_DISCOVERY_INTERNAL_API_KEY is injected from /etc/cold-storage-backend.env during deploy when available.
BUYER_DISCOVERY_DISCOVERY_SOURCE=buyer-discovery-worker
BUYER_DISCOVERY_USE_SAMPLE_SNAPSHOTS=false

# Optional host capability checks for future browser/VPN-backed runs
BUYER_DISCOVERY_REQUIRE_NORDVPN=false
BUYER_DISCOVERY_REQUIRE_BROWSER=false
BUYER_DISCOVERY_BROWSER_BIN=chromium-browser
